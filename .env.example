# PostgreSQL connection string (Neon via Vercel Marketplace or any Postgres instance).
# Pooled connection used by the app at runtime:
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
# Direct (non-pooled) connection used by `prisma migrate`:
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Random secret used to sign session cookies. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"
